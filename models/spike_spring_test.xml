<mujoco model="spike_spring_test">
  <!-- smaller timestep + more iterations -->
  <option timestep="0.0002"
          gravity="0 0 0"
          integrator="implicitfast"
          iterations="400"
          tolerance="1e-10"/>

  <worldbody>
    <body name="base" pos="0 0 0">
      <geom name="base_geom" type="box" size="0.02 0.02 0.005"
            rgba="0.3 0.3 0.3 1"
            contype="1" conaffinity="1"/>

      <!-- Spike tip -->
      <body name="spike_tip" pos="0 0 0.012">
        <!-- DOWN compression is positive because axis is -Z -->
        <joint name="spike_z" type="slide" axis="0 0 -1"
               limited="true" range="0 0.002"
               stiffness="5000" damping="2"/>

        <geom name="tip_geom"
              type="capsule" fromto="0 0 0  0 0 0.010" size="0.002"
              rgba="0.2 0.6 0.9 1"
              contype="1" conaffinity="1"
              friction="1.0 0.01 0.001"
              margin="0.002"
              solref="0.01 1" solimp="0.95 0.99 0.001"/>
      </body>
    </body>

    <!-- Indenter starts close -->
    <body name="indenter" pos="0 0 0.024">
      <joint name="indenter_z" type="slide" axis="0 0 -1"
             limited="true" range="0 0.008"/>

      <geom name="indenter_geom" type="box" size="0.02 0.02 0.002"
            rgba="0.1 0.1 0.1 1"
            contype="1" conaffinity="1"
            margin="0.002"
            solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>

  <actuator>
    <!-- LOW gains to avoid tunneling -->
    <position name="indenter_servo" joint="indenter_z"
              kp="60" kv="6"
              ctrllimited="true" ctrlrange="0 0.008"/>
  </actuator>
</mujoco>
