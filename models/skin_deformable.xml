<mujoco model="skin_crosssection_deformable">
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <worldbody>
    <!-- ground -->
    <geom name="ground" type="plane" size="5 5 0.1" rgba="0.9 0.9 0.9 1"
          friction="1.0 0.01 0.001"/>

    <!-- deformable skin (soft body) -->
    <body name="skin_section" pos="0 0 0.20">
  <freejoint/>

  <!-- IMPORTANT: in your MuJoCo build, inertial requires pos -->
  <inertial pos="0 0 0" mass="1e-4" diaginertia="1e-8 1e-8 1e-8"/>

  <flexcomp name="skinflex" type="mesh" file="assets/skin_scaled.obj" mass="0.05">
    <elasticity
      young="5e5"
      poisson="0.30"
      damping="0.02"
      thickness="0.002"
      elastic2d="both"/>
    <contact selfcollide="none" solimp="0.95 0.99 0.001" solref="0.01 1"/>
    <edge damping="1.0"/>
  </flexcomp>
</body>

    <!-- compression plate -->
    <body name="plate" pos="0 0 0.32">
      <joint name="plate_slide" type="slide" axis="0 0 -1" limited="true" range="0 0.12"/>
      <geom name="plate_geom" type="box" size="0.06 0.06 0.01"
            rgba="0.2 0.2 0.2 1" density="800"
            friction="1.0 0.01 0.001"/>
    </body>
  </worldbody>

  <!-- push plate down/up with a position servo -->
  <actuator>
    <position name="plate_servo" joint="plate_slide" kp="2000"/>
  </actuator>

</mujoco>
