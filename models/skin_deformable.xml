<mujoco model="skin_spring_test_servo">
  <option timestep="0.0005"
          gravity="0 0 0"
          integrator="implicitfast"
          iterations="300"
          tolerance="1e-10"/>

  <worldbody>
    <!-- Bottom plate fixed -->
    <body name="bottom" pos="0 0 0.00">
      <geom name="bottom_geom" type="box" size="0.08 0.08 0.01"
            rgba="0.2 0.2 0.2 1"
            contype="1" conaffinity="1"
            margin="0.002"
            solref="0.05 1" solimp="0.95 0.99 0.001"/>
    </body>

    <!-- Deformable sample fixed in world frame -->
    <body name="skin_section" pos="0 0 0.03">
      <inertial pos="0 0 0" mass="1e-4" diaginertia="1e-8 1e-8 1e-8"/>

      <flexcomp name="skinflex" type="mesh" file="assets/skin_scaled.obj" mass="0.05">
        <!-- start soft + damped; ramp young later -->
        <elasticity young="3e4" poisson="0.30" damping="0.20"
                    thickness="0.002" elastic2d="both"/>

        <!-- this is important for stability; prevents some inversions -->
        <contact internal="true" selfcollide="none"
                 solref="0.05 1" solimp="0.95 0.99 0.001"
                 margin="0.001"/>
        <edge damping="3.0"/>
      </flexcomp>
    </body>

    <!-- Top plate: dynamic body with slide joint -->
    <body name="top" pos="0 0 0.075">
      <!-- axis is -Z so increasing q moves DOWN -->
      <joint name="top_slide" type="slide" axis="0 0 -1" limited="true" range="0 0.04"/>

      <geom name="top_geom" type="box" size="0.08 0.08 0.01"
            rgba="0.2 0.2 0.2 1"
            contype="1" conaffinity="1"
            margin="0.002"
            solref="0.05 1" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Built-in position servo (you set target only; no PID code) -->
    <position name="top_servo" joint="top_slide"
              kp="300" kv="30"
              ctrllimited="true" ctrlrange="0 0.04"/>
  </actuator>
</mujoco>
